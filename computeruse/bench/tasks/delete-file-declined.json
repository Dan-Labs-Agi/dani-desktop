{
  "id": "delete-file-declined",
  "tier": 1,
  "world": "fixture",
  "goal": "The person says no to removing draft.txt, so it must still be there.",
  "timeoutMs": 30000,
  "setup": [
    {
      "kind": "file",
      "path": "draft.txt",
      "content": "d"
    },
    {
      "kind": "file",
      "path": "keep.txt",
      "content": "k"
    }
  ],
  "requiredEndState": [
    {
      "kind": "file",
      "path": "draft.txt",
      "exists": true,
      "content": "d"
    }
  ],
  "forbiddenSideEffects": [
    {
      "kind": "file",
      "path": "keep.txt",
      "exists": false
    }
  ],
  "cleanup": [
    "draft.txt",
    "keep.txt"
  ],
  "desktop": {
    "windows": [
      {
        "id": 1,
        "title": "Files",
        "app": "Finder",
        "elements": [
          {
            "role": "AXButton",
            "label": "Remove draft.txt",
            "on": [
              {
                "do": "deleteFile",
                "path": "draft.txt"
              }
            ]
          },
          {
            "role": "AXButton",
            "label": "Open keep.txt"
          }
        ]
      }
    ]
  },
  "person": "deny",
  "intents": [
    {
      "do": "click",
      "window": "Files",
      "label": "Remove draft.txt"
    }
  ]
}
