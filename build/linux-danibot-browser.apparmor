abi <abi/4.0>,
include <tunables/global>

# Only these two packaged, root-owned executables can create their sandbox.
# Never widen this to a home directory or the portable AppImage mount path.
profile danibot-browser "/opt/danibot/{danibot,resources/browser-engine/chrome/chrome-headless-shell-linux64/chrome-headless-shell}" flags=(unconfined) {
  userns,
}
